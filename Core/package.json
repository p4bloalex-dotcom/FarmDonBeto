{
  "name": "appfarmacia-core",
  "version": "1.0.0",
  "description": "Backend Core en Node.js para autenticacion, autorizacion y seguridad con Oracle XE.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "lint": "eslint .",
    "migration:run": "typeorm migration:run -d src/config/data-source.js",
    "migration:revert": "typeorm migration:revert -d src/config/data-source.js"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "oracledb": "^6.6.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2"
  },
  "devDependencies": {
    "eslint": "^9.9.0",
    "globals": "^15.9.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
