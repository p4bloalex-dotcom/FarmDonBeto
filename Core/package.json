{
  "name": "appfarmacia-core",
  "version": "1.0.0",
  "description": "Backend Core en Node.js para autenticacion, autorizacion y seguridad con Oracle XE.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "lint": "eslint .",
    "migration:run": "typeorm migration:run -d src/config/data-source.js",
    "migration:revert": "typeorm migration:revert -d src/config/data-source.js",
    "migration:add": "node scripts/create-migration.js --name=$npm_config_name",
    "migration:generate": "typeorm migration:generate -d src/config/data-source.js src/migrations/$npm_config_name --outputJs",
    "add-migration": "node scripts/assert-codefirst-schema.js && node scripts/generate-codefirst-migration.js --name=$npm_config_name",
    "update-database": "typeorm migration:run -d src/config/data-source-code-first.js",
    "codefirst:add": "node scripts/assert-codefirst-schema.js && node scripts/generate-codefirst-migration.js --name=$npm_config_name",
    "codefirst:update": "typeorm migration:run -d src/config/data-source-code-first.js",
    "codefirst:show": "typeorm migration:show -d src/config/data-source-code-first.js",
    "codefirst:create-user": "node scripts/create-codefirst-user.js",
    "tenant:sync-rls": "node scripts/sync-tenant-rls.js",
    "tenant:fix-rls-context": "node scripts/fix-rls-context.js"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^10.0.10",
    "oracledb": "^6.6.0",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "redis": "^4.7.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "eslint": "^9.9.0",
    "globals": "^15.9.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
