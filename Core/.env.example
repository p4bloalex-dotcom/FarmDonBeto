NODE_ENV=development
PORT=5246
API_PREFIX=/api

ORACLE_USER=APPFARMACIA
ORACLE_PASSWORD=change-me
ORACLE_CONNECT_STRING=localhost:1521/XEPDB1
ORACLE_POOL_MIN=1
ORACLE_POOL_MAX=10
ORACLE_POOL_INCREMENT=1

JWT_ISSUER=http://localhost:5246
JWT_AUDIENCE=http://localhost:5246
JWT_SIGNING_KEY=change-this-secret-with-at-least-64-characters-before-production
JWT_EXPIRES_IN=1d
JWT_TEMP_EXPIRES_IN=2m

CORS_ORIGINS=http://localhost:4200,http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=10

DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=50
RUN_SEEDERS=false
LOG_LEVEL=info
    